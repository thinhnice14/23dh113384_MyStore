@* Model se duoc truyen giua trang Partial View va trang cha *@
@model _23dh113384_MyStore.Models.Product
<head>
    <style>
        textarea{
            width:100%;
            height:150px;
            padding: 12px 5px;
            box-sizing:border-box;
            border: 1px solid #808080;
            border-radius: 10px;
            background-color:whitesmoke;
            resize:none;
            
        }
    </style>
</head>

@* Cac phan chung cua 02 form Edit.cshtml va Create.cshtml *@
<div class="form-group">
    <div class="control-label col-md-2">Danh mục</div>
    <div class="col-md-10">
        @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="control-label col-md-2">Tên sản phẩm </div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="control-label col-md-2">Đơn giá </div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.ProducPrice, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.ProducPrice, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="control-label col-md-2">Hình ảnh </div>
    <div class="col-md-10">
        @Html.EditorFor(model => model.Productmage, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Productmage, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="control-label col-md-2">Mô tả </div>
    <div class="col-md-10">
        @Html.TextAreaFor(model => model.ProductDescription, new { htmlAttributes = new { @class = "form-control " } })
        @Html.ValidationMessageFor(model => model.ProductDescription, "", new { @class = "text-danger" })
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh mục", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>
