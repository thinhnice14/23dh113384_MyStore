@model _23dh113384_MyStore.Models.Product

<head>
    <style>
        img {
            height: 250px;
            max-width: 250px;
        }
    </style>
</head>

<div class=" container-fluid">
    <div class="div-horizontal">
        <div class="col-md-3 ">
            <img src="@Html.DisplayFor(model => model.Productmage)" />
        </div>
        <div class="col-md-9 ">
            <dl>
                <dt> Tên sản phẩm </dt>
                <dd>@Html.DisplayFor(model => model.ProductName)
                </dd>

                <dt> Đơn giá </dt>
                <dd>@Html.DisplayFor(model => model.ProducPrice)
                </dd>

                <dt> Mô tả  </dt>
                <dd>@Html.DisplayFor(model => model.ProductDescription)
                </dd>

                <dt>Danh mục </dt>
                <dd>@Html.DisplayFor(model => model.Category.CategoryName)
                </dd>
                </dl>
        </div>
    </div>
</div>
